	{topic = "my goldfish", setup = "I named my goldfish Gary.", punch = "He's got a three-second memory. Every lap is his first. Honestly? Goals."},
	{topic = "bees", setup = "Bees make honey and then die for it.", punch = "That's the most 'my job' thing I've ever heard."},
	{topic = "my back", setup = "I threw out my back last week.", punch = "Sneezing. I'm thirty-two and my spine has retired."},
	{topic = "stretching", setup = "I started stretching every morning.", punch = "Mostly just to find out what hurts today."},
