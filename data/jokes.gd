## The joke or one-liner about a topic (with its tags), or {} if none.
static func joke_about(topic: String) -> Dictionary:
	for joke in JOKES:
		if joke.topic == topic:
			return joke
	for one in ONE_LINERS:
		if one.topic == topic:
			return one
	return {}


## Theme of a topic, or "" if it has none.
static func theme_of(topic: String) -> String:
	for theme in THEMES:
		if topic in THEMES[theme]:
			return theme
	return ""


