class_name Jokes
## Everything the comedian can say. Patter (res://engine/patter.gd) picks from
## these without repeats. Add lines freely; keep them short enough for a bubble.

## Two-part jokes: a Setup card says `setup`, the next Punchline says `punch`.
## `topic` is what a later Callback can bring back.
const JOKES := [
	{topic = "my landlord", setup = "My landlord said he'd fix the heat by Friday.", punch = "He didn't say which Friday. Or which century.", tags = ["his idea of 'fixing it' is a sweater with my name on it.", "when I complained, he raised the rent to 'warm up the relationship.'", "his phone number is just a voicemail that sighs."]},
	{topic = "the gym", setup = "I joined a gym to meet new people.", punch = "Now I avoid eye contact with forty strangers at once.", tags = ["the only thing I've lifted is my membership fee off my bank account.", "I go so rarely the front desk asks if I'm a delivery.", "my locker still has a sandwich from January. It's lifting more than I am."]},
	{topic = "my phone", setup = "My phone counts how many steps I take.", punch = "Yesterday it sent one notification: 'buddy...'", tags = ["it suggested I 'try walking to the fridge less.' It knows.", "my screen time report came with a hotline number.", "it auto-locked when I tried to open the step app. Out of pity."]},
	{topic = "my grandma", setup = "My grandma just learned to text.", punch = "Every message ends 'Love, Grandma,' like a letter from the war.", tags = ["she signs off texts to the pizza place with 'God bless.'", "she sends 'LOL' because she thinks it means 'lots of love.' At a funeral.", "her emoji of choice is the eggplant. Nobody has the heart to tell her."]},
	{topic = "the dentist", setup = "My dentist asks questions with both hands in my mouth.", punch = "Then she's annoyed when I say 'aaargh.' That IS my answer, Linda!", tags = ["she asked if I floss and I lied with her whole hand in my mouth.", "her waiting room magazines are from when teeth were invented.", "she gave me a lollipop on the way out. That's a business model."]},
	{topic = "my cat", setup = "My cat knocks things off the table on purpose.", punch = "She's not a pet. She's a tiny physics teacher.", tags = ["she makes eye contact the entire time. It's a threat.", "she's knocked over three glasses this week and zero apologies.", "my insurance now lists her as 'an act of God.'"]},
	{topic = "self checkout", setup = "Self checkout keeps saying 'unexpected item in bagging area.'", punch = "Same, machine. That's me at every party.", tags = ["it called security on a banana. My banana.", "I've done so many shifts there I want an employee discount.", "it asked for an attendant. The attendant was also confused."]},
	{topic = "dating apps", setup = "My date said I look different in person.", punch = "I said, 'Yes. Three-dimensional.'", tags = ["I wore my best shirt. It's the only shirt in my pictures.", "she asked if I always looked this tired. I said only in 3D.", "she went to the bathroom and her profile went to 'hidden.'"]},
	{topic = "my GPS", setup = "My GPS has a calm British voice.", punch = "So when I miss the exit, it sounds disappointed in me personally.", tags = ["it said 'recalculating' like my mom says 'I'm not mad.'", "I swear it said 'oh, for heaven's sake' under its breath.", "I apologized to it. Out loud. In traffic."]},
	{topic = "the weather app", setup = "The weather app said zero percent chance of rain.", punch = "So it rained anyway. Just to prove a point.", tags = ["it updated to 'rain' while I was standing in it.", "it said 'feels like 90.' Feels like? I live here!", "it sent a 'severe weather' alert for a light breeze and my mood."]},
	{topic = "my roommate", setup = "My roommate labels all his food.", punch = "I found a sticky note on an egg that said 'I counted.'", tags = ["the milk has a chore chart.", "he put a tiny padlock on a yogurt.", "I ate one grape and he called a house meeting."]},
	{topic = "flat-pack furniture", setup = "I built flat-pack furniture all by myself.", punch = "Three screws left over, and the chair only works emotionally.", tags = ["the instructions had a cartoon man smiling. That man has never built a chair.", "the allen key is now my most important relationship.", "the bookshelf leans left. Politically and physically."]},
	{topic = "my dad", setup = "My dad thinks every noise in the car is 'the transmission.'", punch = "It was the radio, Dad. That was a love song.", tags = ["he turned the music down to listen to the 'noise' and it went away. Miracle.", "his solution to every car problem is 'give it a minute.'", "he drove to the mechanic and hummed along the whole way."]},
	{topic = "coffee", setup = "I drink five coffees a day.", punch = "I'm not awake. I'm just vibrating at the right frequency.", tags = ["my hands shake so much I can stir it without a spoon.", "my blood type is 'oat milk latte.'", "my barista knows my name, my order and my secrets."]},
	{topic = "the family group chat", setup = "My family group chat has 200 unread messages.", punch = "All of them are my uncle replying 'ok' to things from 2019.", tags = ["my aunt sends a 'good morning' GIF at 4 p.m.", "someone thumbs-downed my birthday post by accident. Two years ago.", "my dad signs every text 'Dad.' We know, Dad. It says Dad."]},
	{topic = "airport security", setup = "Airport security asked if I packed my own bag.", punch = "Sir, look at it. Nobody would HELP me do this.", tags = ["they swabbed my hands like I'm a crime scene.", "I took my shoes off so fast I almost took my socks off out of panic.", "they found a water bottle and looked at me like I'd smuggled the ocean."]},
	{topic = "my houseplant", setup = "I bought a plant to prove I'm responsible.", punch = "It died. Now I have a tiny brown reminder that I'm not.", tags = ["it was a cactus. You can't kill a cactus. I found a way.", "I talked to it every day. Maybe that was the problem.", "the plant shop asked me to stop coming in. For the plants."]},
	{topic = "my boss", setup = "My boss says 'we're a family here.'", punch = "Which explains why nobody talks at dinner and someone's crying.", tags = ["he calls the pizza party 'a raise you can eat.'", "his door is always open. So we can hear him chewing.", "he says 'circle back' like we're sharks."]},
	{topic = "the microwave", setup = "The microwave says two minutes.", punch = "Longest two minutes of my life. I've had shorter relationships.", tags = ["I stood there like it was a TV show.", "the last three seconds are when I make my life decisions.", "I always stop it at one second like I'm defusing a bomb."]},
	{topic = "my smart speaker", setup = "I asked my smart speaker to play something relaxing.", punch = "It read out my bank balance. Very slowly.", tags = ["it followed up with relaxing whale sounds. The whale was crying.", "I asked it for a joke and it said 'your savings.'", "now it plays sad violin every time I order takeout."]},
	{topic = "my mom", setup = "My mom only calls to ask how to use her phone.", punch = "Which she does... from her phone.", tags = ["then she asks why I never call.", "her phone has seventeen calculator apps and no idea why.", "she held the phone to her ear for a video call. I talked to her cheek for an hour."]},
	{topic = "camping", setup = "My friends invited me camping.", punch = "Sleeping on the ground on purpose? We invented beds, Kevin!", tags = ["they said 'it's peaceful.' A raccoon took my sandwich and my dignity.", "I spent the night listening to a 'peaceful' owl scream.", "I brought a pillow and they reacted like I'd brought a butler."]},
	{topic = "online reviews", setup = "I read every review before I buy anything.", punch = "Four hours to choose a spatula. It's fine. It's a spatula.", tags = ["one review just said 'it's okay I guess.' That one haunts me.", "I read a one-star review that was really about the guy's divorce.", "I've left a review for my own review."]},
	{topic = "the bank", setup = "My bank flagged suspicious activity on my card.", punch = "Someone bought a salad. They knew it wasn't me.", tags = ["they froze my card while I was buying a salad. For my health.", "they asked 'did you make this purchase?' Their tone said, 'you? A vegetable?'", "my bank app has a little 'are you okay?' button now."]},
	{topic = "my old car", setup = "My car is so old...", punch = "The check engine light is just a candle.", tags = ["the radio only gets stations from the eighties.", "the seatbelt is just a suggestion with a buckle.", "I don't lock it. I leave a note: 'please take it.'"]},
	{topic = "babies", setup = "My friend had a baby and now only talks about sleep.", punch = "She describes four hours of sleep like a beach vacation.", tags = ["she says 'we' slept badly. The baby slept great.", "she has a spreadsheet for naps and none for her own life.", "she cried at a mattress commercial."]},
	{topic = "passwords", setup = "Every website wants a stronger password.", punch = "Capital letter, number, symbol, and a drop of blood.", tags = ["then it says 'password can't be one you've used before.' I've used ALL of them.", "I reset it so often my security question is 'why are you like this?'", "my password is now just a long scream with a number on the end."]},
	{topic = "brunch", setup = "Brunch is just breakfast that slept in.", punch = "And charges you nineteen dollars for the privilege.", tags = ["the toast has a backstory.", "the mimosa is three dollars of juice and a dream.", "the waiter called my pancakes 'a journey.'"]},
	{topic = "flying", setup = "If I had a superpower, I'd pick flying.", punch = "Not to fight crime. Just to skip traffic. Crime can wait.", tags = ["I'd still have to take off my shoes at the airport, out of habit.", "pigeons would definitely start a beef with me.", "I'd land at work early and still pretend I was stuck in traffic."]},
	{topic = "the bus driver", setup = "The bus driver waited for me today.", punch = "Then closed the door as I got there. Eye contact. The whole time.", tags = ["he waved. Not hello. Goodbye.", "I ran so hard I broke a personal record. For nothing.", "he does it every day. We have a relationship now."]},
	{topic = "the Wi-Fi", setup = "My neighbor named his Wi-Fi 'Stop Stealing My Wi-Fi.'", punch = "So I named mine 'No.'", tags = ["his new one is called 'FBI Van 3.'", "now he slides notes under my door that say 'Yes.'", "we've never met. We only speak in network names."]},
	{topic = "my therapist", setup = "My therapist says I use humor to deflect.", punch = "Which is funny, because... look, a bird!", tags = ["she charges by the hour and I charge by the joke.", "she wrote something down and I'm sure it was 'ha.'", "I told her a knock-knock joke and she said 'who's there? Feelings.'"]},
	{topic = "sushi", setup = "On a first date I tried to eat sushi with chopsticks.", punch = "One piece went flying. She caught it. We're engaged now.", tags = ["the waiter applauded. The fish did not.", "at the wedding we served the same roll. As a toast.", "I still can't use chopsticks. She feeds me now."]},
	{topic = "my smartwatch", setup = "My smartwatch told me to stand up.", punch = "I said 'you're not my real mom' and sat back down.", tags = ["it vibrated angrily for an hour.", "it gave me a 'move goal' and I gave it a 'move out.'", "now it just says 'I've given up' every morning."]},
	{topic = "Mondays", setup = "Mondays are hard.", punch = "Even my alarm clock sounds like it's apologizing.", tags = ["my coffee makes a face before I do.", "even my cat goes to work on Mondays. Under the bed.", "the calendar should just say 'nope' on that square."]},
	{topic = "the magician", setup = "I dated a magician once.", punch = "Halfway through dinner, she disappeared. Great trick. I got the bill.", tags = ["she pulled my card out of my wallet. My credit card.", "she sawed our relationship in half. Clean cut.", "for her next trick, she made my texts go unanswered."]},
	{topic = "pigeons", setup = "Pigeons walk like they've got somewhere to be.", punch = "Where, Gary? You live at the bus stop.", tags = ["he's been 'on his way' since 2014.", "he struts around like he owns the bench. He kind of does.", "he nodded at me like we have a business arrangement."]},
	{topic = "my high school reunion", setup = "My high school reunion is next month.", punch = "I've been working out. Mostly my excuses.", tags = ["I'm bringing a fake fiancé and a real anxiety.", "my plan is to arrive late and leave early. Like my homework.", "I'm going to tell everyone I'm 'in entertainment.' Technically."]},
	{topic = "late fees", setup = "The library charges late fees.", punch = "So my copy of 'How to Save Money' cost me forty bucks.", tags = ["I returned it so late the book had a sequel.", "the librarian looked at me like I'd stolen the Dead Sea Scrolls.", "it's the most I've ever learned about money."]},
	{topic = "karaoke", setup = "I sang karaoke last night and they asked for an encore.", punch = "Of the silence before I started.", tags = ["the DJ played my song and then just... left the building.", "I did a ballad. Someone called a doctor.", "I got a standing ovation. Everyone was standing up to leave."]},
	{topic = "salt", setup = "My doctor told me to cut back on salt.", punch = "So now I just cry on my fries. Same thing.", tags = ["my tears have more seasoning than my meals.", "I now season my food by telling it about my day.", "the fries are fine. I'm the one who's salty."]},
	{topic = "the warranty call", setup = "I got a call about my car's extended warranty.", punch = "I don't have a car. I was just flattered someone cared.", tags = ["I asked them to stay on the line and tell me about their day.", "we talked for an hour. They called back. It's the longest relationship I've had.", "I told them about my bike. They offered coverage."]},
	{topic = "astronauts", setup = "Astronauts train for years to live in a tiny space with no privacy.", punch = "I call that my first apartment.", tags = ["my roommate had a toilet in the kitchen. NASA would have fired him.", "astronauts get a view. I got a view of a dumpster.", "at least astronauts float. I just lay on the floor."]},
	{topic = "my neighbor's dog", setup = "My neighbor's dog barks at every leaf.", punch = "Honestly? Same energy I bring to my inbox.", tags = ["he barks at the mailman like he owes him money.", "one leaf fell and he called his lawyer.", "he's the only one in the building doing security."]},
	{topic = "the gender reveal", setup = "I went to a gender reveal party.", punch = "The cake was blue. The fire department was also blue.", tags = ["they found out it's a boy and a forest fire.", "the baby is two now and still has a fire department godfather.", "the next one is a lemonade stand. Safer."]},
	{topic = "my upstairs neighbor", setup = "My upstairs neighbor walks like he's training for something.", punch = "I started clapping when he finishes. Last night he took a bow.", tags = ["I think he's training for a marathon or a war.", "he does jumping jacks at three a.m. like the floor owes him money.", "my ceiling light now dances better than I do."]},
	{topic = "the thermostat", setup = "My thermostat and I are in a cold war.", punch = "I turn it up. Someone turns it down. I live alone.", tags = ["either it's haunted or I'm sleepwalking with opinions.", "I put a lock on it. Someone turned the lock down.", "I set it to 70. It said 'sure' and did 64 out of spite."]},
	{topic = "my doorbell camera", setup = "I bought a doorbell camera for security.", punch = "Now I get forty alerts a day about a leaf. The leaf is not a threat.", tags = ["I watched a squirrel steal a pumpkin in 4K.", "it's mostly a documentary about a cat named Dennis.", "it caught me on camera talking to myself. In my own doorway."]},
	{topic = "autocorrect", setup = "Autocorrect changed 'on my way' to 'on my weigh.'", punch = "Now my whole family thinks I'm on a diet.", tags = ["my grandma sent a recipe for 'low-fat salvation.'", "I typed 'love you' and it changed it to 'leave you.' My wife's still mad.", "it changed my name to 'Brain.' Aspirational."]},
	{topic = "video calls", setup = "On video calls I'm on mute ninety percent of the time.", punch = "The other ten percent I'm saying, 'Can you hear me?'", tags = ["I've given full presentations on mute. My best work.", "my cat has been in more meetings than my boss.", "I wear a shirt and pajama pants. Business on top, nap on the bottom."]},
	{topic = "the office fridge", setup = "Someone keeps stealing my lunch from the office fridge.", punch = "So I wrote 'Dave' on it. Dave is very confused.", tags = ["now I bring my lunch in a briefcase with a combination lock.", "someone left a note: 'Dave says thanks.'", "there's a yogurt in there older than the company."]},
	{topic = "meetings", setup = "My boss scheduled a meeting about why we have so many meetings.", punch = "Next week: a meeting about the meeting about the meetings.", tags = ["the minutes from the last meeting just say 'help.'", "I've got a meeting to plan my lunch break.", "my calendar looks like a game of Tetris that's losing."]},
	{topic = "my sister", setup = "My sister says she's Mom's favorite.", punch = "Mom said, 'I love you both equally.' That's exactly what you say about the one who isn't.", tags = ["at Christmas Mom gave her a car and me a 'heartfelt' sock.", "my sister's baby photos are framed. Mine are evidence.", "Mom calls me by the dog's name. Then my sister's. Then mine."]},
	{topic = "family reunions", setup = "At family reunions somebody always asks what I do now.", punch = "I say comedy. They say, 'Oh, for fun?' Yes. Very.", tags = ["my uncle says 'comedy, huh? Tell me a joke.' He's never laughed at anything.", "my aunt pinches my cheek and checks my ring finger in one move.", "I'm the cautionary tale at the potato salad table."]},
	{topic = "my brother", setup = "My brother says he's between jobs.", punch = "It's been nine years. That's not between, that's a city.", tags = ["he moved back in with Mom 'temporarily.' Since the dinosaurs.", "he calls the couch his 'home office.'", "his job title is 'figuring it out.'"]},
	{topic = "weddings", setup = "I'm at the age where weddings are my entire social life.", punch = "Free food, open bar, and a stranger crying at me. Beautiful.", tags = ["I've caught three bouquets. I'm not lucky, I'm tall.", "I've given so many toasts I'm basically bread.", "my plus-one is a sandwich in my jacket."]},
	{topic = "first dates", setup = "On a first date I asked, 'What are you into?'", punch = "She said, 'Quiet.' So we sat in silence. Best date of my life.", tags = ["we've been dating a year now. We've said four words.", "she asked for the check by humming. I got it.", "the waiter thought we were in a fight. We were in love."]},
	{topic = "my ex", setup = "My ex said we could still be friends.", punch = "I said sure, same rules: you don't text and I don't call. Friends.", tags = ["she still has my hoodie. I'm in a custody battle with a sweater.", "she liked a photo of mine from 2016. I've been thinking about it since.", "we're such good friends I found out she moved from the mailman."]},
	{topic = "my dating profile", setup = "My dating profile says I love hiking.", punch = "I hiked once. To the fridge. Uphill, both ways.", tags = ["I said I'm 'adventurous.' I tried a new cereal once.", "my profile picture is from a wedding I wasn't invited to.", "I put 'six foot.' I am six foot. Lying down. In boots."]},
	{topic = "the grocery store", setup = "I go to the grocery store for one thing.", punch = "I leave with eleven things and no memory of the one.", tags = ["the one thing was milk. I came home with a cactus and a feeling.", "I went in for bread and came out with a membership.", "I always grab a cart for one thing, like I'm hoping to be surprised."]},
	{topic = "meal prep", setup = "I tried meal prepping for the week.", punch = "By Monday I was a man with no meals and a lot of containers.", tags = ["I labeled them Monday through Friday. Friday was ice cream.", "my fridge looked like a hospital for chicken.", "by Wednesday I was eating rice like I was being punished."]},
	{topic = "tacos", setup = "Tacos are the only food that falls apart on purpose.", punch = "Every bite is a surprise party for my shirt.", tags = ["I eat them leaning forward like I'm in a wind tunnel.", "the shell breaks on the first bite like a bad promise.", "I've worn three tacos home on one shirt."]},
	{topic = "leftovers", setup = "I love leftovers.", punch = "It's like a text from past me that says, 'I got you.'", tags = ["future me always forgets the fork, though.", "I'm the only one who knows what 'mystery container' is. It's always chili.", "the microwave has a 'leftover' setting. It's just 'try again.'"]},
	{topic = "my dog", setup = "My dog greets me like I just came back from war.", punch = "I went to the mailbox. Four minutes. Parade.", tags = ["if I leave for a week he files a missing persons report.", "he cries when I leave the room like I'm going to sea.", "my wife gets a nod. I get a parade."]},
	{topic = "my goldfish", setup = "I named my goldfish Gary.", punch = "He's got a three-second memory. Every lap is his first. Honestly? Goals.", tags = ["I've introduced myself to him four hundred times.", "every time I feed him he acts like I'm a stranger with snacks.", "he's living the dream: no memories, no regrets, no rent."]},
	{topic = "bees", setup = "Bees make honey and then die for it.", punch = "That's the most 'my job' thing I've ever heard.", tags = ["imagine making a sweet thing for people and they wear a protective suit to meet you.", "they work themselves to death for a queen who never says thanks. Relatable.", "a bee has a better work ethic than my whole office."]},
	{topic = "my back", setup = "I threw out my back last week.", punch = "Sneezing. I'm thirty-two and my spine has retired.", tags = ["I now groan getting into a chair like I'm docking a ship.", "my chiropractor says I have 'the spine of a question mark.'", "I bent down to tie a shoe and stayed there for a while. Reflecting."]},
	{topic = "stretching", setup = "I started stretching every morning.", punch = "Mostly just to find out what hurts today.", tags = ["I touched my toes once. We haven't spoken since.", "my knees crack like popcorn. I'm a snack bar.", "I do the 'downward dog' and my dog looks embarrassed for me."]},
	{topic = "my glasses", setup = "I couldn't find my glasses all morning.", punch = "They were on my head. That's the plot of my whole life.", tags = ["I put on my glasses to look for my glasses.", "they were on my head in the photo for my ID.", "I once searched for them using the flashlight on my phone. While on a call."]},
	{topic = "my allergies", setup = "My allergies are so bad I'm allergic to spring.", punch = "Which is basically being allergic to hope.", tags = ["I sneeze at flowers like they owe me money.", "I bought my mom a bouquet and had to leave the room.", "the pollen count is basically my horoscope."]},
	{topic = "subscriptions", setup = "I pay for six streaming services.", punch = "I watch one show. On a free trial. Of a seventh.", tags = ["I'm paying for a cooking show I've never watched to keep a recipe I've never made.", "one is for a channel that only shows trains. I watched one train.", "I signed up for a free trial in 2019. It's now my second rent."]},
	{topic = "my rent", setup = "My rent went up again.", punch = "For what? The apartment's the same. Smaller, but with more rent.", tags = ["my landlord calls it 'market value.' The market must be mad at me.", "I pay extra for a 'view.' The view is another wall.", "my bathroom is so small I have to step outside to change my mind."]},
	{topic = "my credit score", setup = "My credit score is like my high school GPA.", punch = "Nobody's proud of it and everyone's surprised.", tags = ["it's the only score in my life that goes down with practice.", "the bank called it 'creative.'", "I checked it and it checked on me."]},
	{topic = "tipping", setup = "Now the screen asks for a tip before I even get my coffee.", punch = "Sir, I haven't received a bean, let alone been served.", tags = ["the self-checkout asked for a tip. For WHO?", "I tipped once and the screen said 'wow, thanks.' I've never felt more seen.", "I'm scared they'll start asking at the dentist."]},
	{topic = "the DMV", setup = "I went to the DMV today.", punch = "Four hours later I left with a number and a deep respect for waiting.", tags = ["the photo makes me look like I'm being arrested for a sandwich.", "my number was 437. They were on 12.", "I saw a man grow a beard in line."]},
	{topic = "traffic", setup = "Traffic is the only place strangers all agree.", punch = "Everyone's thinking, 'Why are they so slow?' And we're all them.", tags = ["I waved someone in once. They're my godson now.", "I've eaten a full meal in the left lane.", "my car has seen more of the highway than my family has seen of me."]},
	{topic = "rental cars", setup = "I rented a car and got a free upgrade.", punch = "To a bigger car I can't park. Thanks. I'm broke now.", tags = ["I spent twenty minutes looking for the gas cap. It was electric.", "they gave me a 'compact' car that's basically a shoe with wheels.", "the 'full tank' was full of lies."]},
	{topic = "airplane food", setup = "Airplane food is how you know you're in the sky.", punch = "Nothing on earth tastes like that. Thank goodness.", tags = ["the chicken was so dry it asked for water.", "the bread roll has the strength of a stone.", "they called it 'pasta.' It was paste with ambition."]},
	{topic = "hotel pillows", setup = "Hotel beds come with twelve pillows.", punch = "I use one. The rest watch me like a jury.", tags = ["one of them is a decorative cylinder. Nobody knows what it's for.", "I throw eleven of them on the floor and feel like a monster.", "the mint on the pillow is the only thing I trust."]},
	{topic = "group projects", setup = "Every group project has one guy doing everything.", punch = "I always thought it was me. It was Kevin. And Kevin hated it.", tags = ["one guy only showed up for the photo.", "our group chat was called 'Team Synergy.' We never synergized.", "I did the font. I'm very proud of the font."]},
	{topic = "my commute", setup = "My commute is forty minutes of regret.", punch = "And the way home is forty minutes of looking forward to regret.", tags = ["I've listened to an entire audiobook about a guy who also hates his commute.", "my car has a seat that's shaped like my bad decisions.", "I sing in the car so loud the next lane sends requests."]},
	{topic = "hold music", setup = "I called customer service and got hold music.", punch = "Seventy minutes in, I started to like the song. That's how they get you.", tags = ["it's the same eight seconds of flute on loop. I know it by heart now.", "they keep saying 'your call is important to us.' Then prove it, flute!", "when someone finally answered I said, 'Can you play it again?'"]},
	{topic = "my smart fridge", setup = "I got a smart fridge.", punch = "It texts me when the door's open. That's how I learned how often I open it.", tags = ["it suggested 'a light salad.' The fridge is judging me now.", "it sends me pictures of my own cheese like it's a hostage situation.", "it has a screen so I can watch videos about food while I eat food."]},
	{topic = "podcasts", setup = "Everyone has a podcast now. I have a voice memo of me walking.", punch = "It's titled 'Part One.' There is no part two.", tags = ["I have one listener. It's my mom and she's on 1.5 speed.", "the voice memo has more drama than most shows: I trip at minute four.", "I got an ad deal. It's for a sandwich. I'm reading it while eating it."]},
	{topic = "loud neighbors", setup = "My neighbors party until two in the morning.", punch = "I knocked to complain. Now I'm in their group chat.", tags = ["now I'm at every party and I still complain about the noise.", "they made me DJ. The music's quieter now. Nobody's happy.", "the police showed up and I had to pretend I lived there too."]},
	{topic = "moving", setup = "Moving is the worst.", punch = "You find out you own five hundred things you'd never miss and you pay a man to carry them.", tags = ["I found a box I hadn't opened since the last move. It's a box of boxes.", "my friends helped for pizza. One slice each. Very good friends.", "I labeled a box 'misc' and now it's my whole personality."]},
	{topic = "birthdays", setup = "I'm too old for a birthday party.", punch = "But never too old for a cake and a nap.", tags = ["I blew out the candles and pulled a muscle.", "I'm at the age where the candles cost more than the cake.", "my wish is the same every year: a nap that doesn't hurt."]},
	{topic = "the mall", setup = "The mall is just a hallway with ambitions.", punch = "And a smell that says, 'Cinnamon, with consequences.'", tags = ["the food court has a sushi place next to a pretzel place. Choose your fighter.", "there's always one store that only sells phone cases and hope.", "the escalator is the only cardio I get all year."]},
	{topic = "jury duty", setup = "I got called for jury duty.", punch = "Twelve strangers deciding one stranger's fate, and the vending machine is out of pretzels.", tags = ["I was picked because I said 'I don't know' to every question.", "the lawyer asked if I could be impartial and I said 'about pretzels? No.'", "we reached a verdict faster than we reached a lunch order."]},
	{topic = "public speaking", setup = "They say to picture the audience in their underwear.", punch = "I tried. Now I can't look at my dentist.", tags = ["I tried it at my sister's wedding. The priest gave me a look.", "my hands sweat so much I can't hold the mic. I just hug it.", "I practiced in the mirror and the mirror booed."]},
]

## Which theme each joke topic belongs to. A Setup prefers a joke from the
## same theme as the last one told, so a set sounds like one act, not a pile.
const THEMES := {
