class_name Jokes
## Everything the comedian can say. Patter (res://engine/patter.gd) picks from
## these without repeats. Add lines freely; keep them short enough for a bubble.

## Two-part jokes: a Setup card says `setup`, the next Punchline says `punch`.
## `topic` is what a later Callback can bring back.
const JOKES := [
	{topic = "my landlord", setup = "My landlord said he'd fix the heat by Friday.", punch = "He didn't say which Friday. Or which century."},
	{topic = "the gym", setup = "I joined a gym to meet new people.", punch = "Now I avoid eye contact with forty strangers at once."},
	{topic = "my phone", setup = "My phone counts how many steps I take.", punch = "Yesterday it sent one notification: 'buddy...'"},
	{topic = "my grandma", setup = "My grandma just learned to text.", punch = "Every message ends 'Love, Grandma,' like a letter from the war."},
	{topic = "the dentist", setup = "My dentist asks questions with both hands in my mouth.", punch = "Then she's annoyed when I say 'aaargh.' That IS my answer, Linda!"},
	{topic = "my cat", setup = "My cat knocks things off the table on purpose.", punch = "She's not a pet. She's a tiny physics teacher."},
	{topic = "self checkout", setup = "Self checkout keeps saying 'unexpected item in bagging area.'", punch = "Same, machine. That's me at every party."},
	{topic = "dating apps", setup = "My date said I look different in person.", punch = "I said, 'Yes. Three-dimensional.'"},
	{topic = "my GPS", setup = "My GPS has a calm British voice.", punch = "So when I miss the exit, it sounds disappointed in me personally."},
	{topic = "the weather app", setup = "The weather app said zero percent chance of rain.", punch = "So it rained anyway. Just to prove a point."},
	{topic = "my roommate", setup = "My roommate labels all his food.", punch = "I found a sticky note on an egg that said 'I counted.'"},
	{topic = "flat-pack furniture", setup = "I built flat-pack furniture all by myself.", punch = "Three screws left over, and the chair only works emotionally."},
	{topic = "my dad", setup = "My dad thinks every noise in the car is 'the transmission.'", punch = "It was the radio, Dad. That was a love song."},
	{topic = "coffee", setup = "I drink five coffees a day.", punch = "I'm not awake. I'm just vibrating at the right frequency."},
	{topic = "the family group chat", setup = "My family group chat has 200 unread messages.", punch = "All of them are my uncle replying 'ok' to things from 2019."},
	{topic = "airport security", setup = "Airport security asked if I packed my own bag.", punch = "Sir, look at it. Nobody would HELP me do this."},
	{topic = "my houseplant", setup = "I bought a plant to prove I'm responsible.", punch = "It died. Now I have a tiny brown reminder that I'm not."},
	{topic = "my boss", setup = "My boss says 'we're a family here.'", punch = "Which explains why nobody talks at dinner and someone's crying."},
	{topic = "the microwave", setup = "The microwave says two minutes.", punch = "Longest two minutes of my life. I've had shorter relationships."},
	{topic = "my smart speaker", setup = "I asked my smart speaker to play something relaxing.", punch = "It read out my bank balance. Very slowly."},
	{topic = "my mom", setup = "My mom only calls to ask how to use her phone.", punch = "Which she does... from her phone."},
	{topic = "camping", setup = "My friends invited me camping.", punch = "Sleeping on the ground on purpose? We invented beds, Kevin!"},
	{topic = "online reviews", setup = "I read every review before I buy anything.", punch = "Four hours to choose a spatula. It's fine. It's a spatula."},
	{topic = "the bank", setup = "My bank flagged suspicious activity on my card.", punch = "Someone bought a salad. They knew it wasn't me."},
	{topic = "my old car", setup = "My car is so old...", punch = "The check engine light is just a candle."},
	{topic = "babies", setup = "My friend had a baby and now only talks about sleep.", punch = "She describes four hours of sleep like a beach vacation."},
	{topic = "passwords", setup = "Every website wants a stronger password.", punch = "Capital letter, number, symbol, and a drop of blood."},
	{topic = "brunch", setup = "Brunch is just breakfast that slept in.", punch = "And charges you nineteen dollars for the privilege."},
	{topic = "flying", setup = "If I had a superpower, I'd pick flying.", punch = "Not to fight crime. Just to skip traffic. Crime can wait."},
	{topic = "the bus driver", setup = "The bus driver waited for me today.", punch = "Then closed the door as I got there. Eye contact. The whole time."},
	{topic = "the Wi-Fi", setup = "My neighbor named his Wi-Fi 'Stop Stealing My Wi-Fi.'", punch = "So I named mine 'No.'"},
	{topic = "my therapist", setup = "My therapist says I use humor to deflect.", punch = "Which is funny, because... look, a bird!"},
	{topic = "sushi", setup = "On a first date I tried to eat sushi with chopsticks.", punch = "One piece went flying. She caught it. We're engaged now."},
	{topic = "my smartwatch", setup = "My smartwatch told me to stand up.", punch = "I said 'you're not my real mom' and sat back down."},
	{topic = "Mondays", setup = "Mondays are hard.", punch = "Even my alarm clock sounds like it's apologizing."},
	{topic = "the magician", setup = "I dated a magician once.", punch = "Halfway through dinner, she disappeared. Great trick. I got the bill."},
	{topic = "pigeons", setup = "Pigeons walk like they've got somewhere to be.", punch = "Where, Gary? You live at the bus stop."},
	{topic = "my high school reunion", setup = "My high school reunion is next month.", punch = "I've been working out. Mostly my excuses."},
	{topic = "late fees", setup = "The library charges late fees.", punch = "So my copy of 'How to Save Money' cost me forty bucks."},
	{topic = "karaoke", setup = "I sang karaoke last night and they asked for an encore.", punch = "Of the silence before I started."},
	{topic = "salt", setup = "My doctor told me to cut back on salt.", punch = "So now I just cry on my fries. Same thing."},
	{topic = "the warranty call", setup = "I got a call about my car's extended warranty.", punch = "I don't have a car. I was just flattered someone cared."},
	{topic = "astronauts", setup = "Astronauts train for years to live in a tiny space with no privacy.", punch = "I call that my first apartment."},
	{topic = "my neighbor's dog", setup = "My neighbor's dog barks at every leaf.", punch = "Honestly? Same energy I bring to my inbox."},
	{topic = "the gender reveal", setup = "I went to a gender reveal party.", punch = "The cake was blue. The fire department was also blue."},
]

